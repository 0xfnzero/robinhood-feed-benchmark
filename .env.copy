# Copy to .env and fill in your endpoints. .env is gitignored — never commit real IPs/tokens.
#
# Official mainnet Feed is included by default as endpoint 1.
# Set FEED_INCLUDE_OFFICIAL=false to compare only the custom Feeds below.

# FEED_INCLUDE_OFFICIAL=false

# FEED_NAME_1=MyFeed
# FEED_URL_1=wss://your-feed.example.com
# FEED_TOKEN_1=

# FEED_NAME_2=AnotherFeed
# FEED_URL_2=wss://another-feed.example.com
# FEED_TOKEN_2=

FEED_COMPARISON_DURATION=30s
