# Copy to .env and fill in your credentials. .env is gitignored — never commit secrets.
#
# FEED_VENDOR_N is the wire format (not a brand name):
#   RHF2      — binary TCP stream (peer pushes to your listen port)
#   NitroFeed — Nitro JSON WebSocket (ws:// or wss://)
#
# FEED_AUTH_TOKEN_N is the generic credential field. How it is applied depends
# on the FEED_URL host (path segment vs request header vs Bearer).
# FEED_TOKEN_N remains supported as an alias.
#
# --- Official Nitro Feed (opt-in) ---
# FEED_INCLUDE_OFFICIAL=true

# --- RHF2 binary TCP ---
# FEED_VENDOR_1=RHF2
# FEED_URL_1=tcp://0.0.0.0:19770

# Convert RHF2 -> Nitro WebSocket with ./run-rhf2-relay.sh
# Clients connect to ws://127.0.0.1:${NITRO_FEED_PORT}/feed
# NITRO_FEED_HOST=0.0.0.0
# NITRO_FEED_PORT=9642
# NITRO_FEED_PATH=/feed

# --- Nitro WebSocket ---
# FEED_VENDOR_2=NitroFeed
# FEED_NAME_2=Ours
# FEED_URL_2=ws://127.0.0.1:9642/feed

# FEED_VENDOR_3=NitroFeed
# FEED_NAME_3=Cloud
# FEED_URL_3=wss://<provider-host>/...
# FEED_AUTH_TOKEN_3=<token>

# --- RBH1 (rh-feed-pro gateway) ---
# Public WSS Binary: path /bin, header X-Token
# FEED_INCLUDE_OFFICIAL=true
# FEED_VENDOR_1=RBH1
# FEED_NAME_1=RBH1
# FEED_URL_1=ws://127.0.0.1:9642/bin
# FEED_AUTH_TOKEN_1=xt_...
# FEED_AUTH_HEADER_1=X-Token
# Optional Nitro Text on same gateway (needs a *different* token; one session per token):
# FEED_VENDOR_2=NitroFeed
# FEED_NAME_2=GatewayNitro
# FEED_URL_2=ws://127.0.0.1:9642/
# FEED_AUTH_TOKEN_2=xt_other_...
# FEED_AUTH_HEADER_2=X-Token

FEED_COMPARISON_DURATION=30s
